想获得唯一键

type, egg, hello
可以用MapReduce做到这一点：

mr = db.runCommand({
  "mapreduce" : "my_collection",
  "map" : function() {
    for (var key in this) { emit(key, null); }
  },
  "reduce" : function(key, stuff) { return null; }, 
  "out": "my_collection" + "_keys"
})
然后在生成的集合上运行distinct，以找到所有的键：

db[mr.result].distinct("_id")
["foo", "bar", "baz", "_id", ...]
